{
    "extends": "Default Dark.sublime-theme",
    "variables": {
        "bg": "#010305",
        "bg-alt": "#05080C",
        "bg-alt2": "#030508",
        "fg": "#FFFFFF",
        "fg-muted": "#c8f9ff",
        "fg-dim": "#656565",
        "border": "#00bbff30",
        "line-highlight": "#081018",
        "selection": "#0D2035",
        "cyan": "#00FFCC",
        "cyan-soft": "#8AFDFF",
        "orange": "#FF6D00",
        "orange-soft": "#FF9100",
        "pink": "#FF2A5F"
    },
    "rules": [
        {
            "class": "sidebar_container",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_tree",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_heading",
            "color": "var(fg)",
            "font.bold": true
        },
        {
            "class": "sidebar_label",
            "color": "var(fg-muted)"
        },
        {
            "class": "sidebar_label",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "color": "var(cyan)"
        },
        {
            "class": "tree_row",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tree_row",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(selection)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tabset_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_control",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_control",
            "attributes": [
                "hover",
                "!selected"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 0.6
        },
        {
            "class": "tab_label",
            "color": "var(fg)"
        },
        {
            "class": "tab_label",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "color": "var(cyan)",
            "font.bold": true
        },
        {
            "class": "tab_label",
            "attributes": [
                "dirty"
            ],
            "color": "var(orange-soft)"
        },
        {
            "class": "status_bar",
            "layer0.tint": "var(bg)",
            "layer0.opacity": 1.0
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "status_container"
                }
            ],
            "color": "var(fg-muted)"
        },
        {
            "class": "scroll_bar_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 0.6
        },
        {
            "class": "scroll_track_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 0.3
        },
        {
            "class": "puck_control",
            "layer0.tint": "var(cyan-soft)",
            "layer0.opacity": 0.4
        },
        {
            "class": "overlay_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "quick_panel_label",
            "fg": "var(fg)",
            "match_fg": "var(cyan)",
            "selected_fg": "var(cyan)",
            "selected_match_fg": "var(orange-soft)",
            "bg": "var(bg-alt2)"
        },
        {
            "class": "quick_panel_path_label",
            "fg": "var(fg-dim)"
        },
        {
            "class": "popup_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "title_bar",
            "style": "dark"
        },
        {
            "class": "title_bar",
            "platforms": [
                "osx"
            ],
            "fg": "var(fg)",
            "bg": "var(bg)"
        },
        {
            "class": "button_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "button_control"
                }
            ],
            "color": "var(fg)"
        },
        {
            "class": "text_line_control",
            "color_scheme_tint": "var(bg-alt2)"
        }
    ]
}