{
    "extends": "Adaptive.sublime-theme",
    "variables": {
        "dl_background": "#010305",
        "dl_panel": "#05080C",
        "dl_sidebar": "#030508",
        "dl_tabbar": "#030a0c",
        "dl_tab_active": "#0A1017",
        "dl_tab_inactive": "#05080C",
        "dl_hover": "#0A1017",
        "dl_active": "#0D1B2A",
        "dl_border": "#2A3846",
        "dl_border_cyan": "#00bbff2d",
        "dl_border_tab": "#00f2ff40",
        "dl_separator": "#FFFFFF1A",
        "dl_text_dim": "#656565",
        "dl_text_muted": "#71d2ffe6",
        "dl_text": "#A1A1A1",
        "dl_text_bright": "#FFFFFF",
        "dl_accent": "#00E8FF",
        "dl_accent_soft": "#00bbff",
        "dl_orange": "#FF6D00",
        "dl_orange_soft": "#FF9100",
        "dl_input": "#080D14"
    },
    "rules": [
        // =========================================================
        // VENTANA Y TÍTULO
        // =========================================================
        {
            "class": "title_bar",
            "bg": "var(dl_background)",
            "fg": "var(dl_text_bright)"
        },

        // =========================================================
        // MENÚ CONTEXTUAL Y MENÚ PRINCIPAL (Estilo DLUnire)
        // =========================================================
        {
            "class": "menu",
            "layer0.texture": "",
            "layer0.tint": "var(dl_panel)",
            "layer0.opacity": 1.0,
            "layer1.texture": "",
            "layer1.tint": "var(dl_border)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": 1,
            "content_margin": [4, 4]
        },
        {
            "class": "menu_item",
            "layer0.texture": "",
            "layer0.tint": [0, 0, 0, 0],
            "layer0.opacity": 1.0,
            "content_margin": [12, 6]
        },
        {
            "class": "menu_item",
            "attributes": ["selected"],
            "layer0.tint": "var(dl_hover)",
            "layer0.opacity": 1.0
        },
        {
            "class": "menu_item",
            "attributes": ["disabled"],
            "layer0.opacity": 0.0
        },
        {
            "class": "menu_item_label",
            "color": "var(dl_text)",
            "font.size": 11
        },
        {
            "class": "menu_item_label",
            "parents": [
                {
                    "class": "menu_item",
                    "attributes": ["selected"]
                }
            ],
            "color": "var(dl_text_bright)"
        },
        {
            "class": "menu_item_label",
            "parents": [
                {
                    "class": "menu_item",
                    "attributes": ["disabled"]
                }
            ],
            "color": "var(dl_text_dim)"
        },
        {
            "class": "menu_item_shortcut",
            "color": "var(dl_text_dim)",
            "font.size": 10
        },
        {
            "class": "menu_item_shortcut",
            "parents": [
                {
                    "class": "menu_item",
                    "attributes": ["selected"]
                }
            ],
            "color": "var(dl_accent)"
        },
        {
            "class": "menu_item_separator",
            "layer0.texture": "",
            "layer0.tint": "var(dl_separator)",
            "layer0.opacity": 1.0,
            "content_margin": [0, 4]
        },
        {
            "class": "menu_item_arrow",
            "layer0.tint": "var(dl_text)",
            "layer0.opacity": 0.8
        },
        {
            "class": "menu_item_arrow",
            "parents": [
                {
                    "class": "menu_item",
                    "attributes": ["selected"]
                }
            ],
            "layer0.tint": "var(dl_accent)",
            "layer0.opacity": 1.0
        },
        {
            "class": "menu_item_checkbox",
            "layer0.tint": "var(dl_accent)"
        },
        {
            "class": "menu_item_radio",
            "layer0.tint": "var(dl_accent)"
        },

        // =========================================================
        // BARRA LATERAL (Sidebar) CON BORDES Y SELECCIÓN DLUNIRE
        // =========================================================
        {
            "class": "sidebar_container",
            "layer0.texture": "",
            "layer0.tint": "var(dl_sidebar)",
            "layer0.opacity": 1.0,
            "layer1.texture": "",
            "layer1.tint": "var(dl_border_cyan)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": [0, 0, 1, 0]
        },
        {
            "class": "sidebar_tree",
            "layer0.texture": "",
            "layer0.tint": "var(dl_sidebar)",
            "layer0.opacity": 1.0,
            "row_padding": [12, 6],
            "indent_offset": 12,
            "indent": 14
        },
        {
            "class": "sidebar_heading",
            "color": "var(dl_text_bright)",
            "font.bold": true
        },
        {
            "class": "sidebar_label",
            "color": "var(dl_text)"
        },
        {
            "class": "tree_row",
            "layer0.texture": "",
            "layer0.tint": [0, 0, 0, 0],
            "layer0.opacity": 1.0
        },
        {
            "class": "tree_row",
            "attributes": ["hover"],
            "layer0.tint": "var(dl_hover)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tree_row",
            "attributes": ["selected"],
            "layer0.tint": "var(dl_active)",
            "layer0.opacity": 1.0,
            // Indicador de borde izquierdo activo en cian DLUnire
            "layer1.texture": "",
            "layer1.tint": "var(dl_accent)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": [2, 0, 0, 0]
        },
        {
            "class": "sidebar_label",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": ["hover"]
                }
            ],
            "color": "var(dl_text_bright)"
        },
        {
            "class": "sidebar_label",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": ["selected"]
                }
            ],
            "color": "var(dl_accent)",
            "font.bold": true
        },

        // Iconos de Carpetas y Desplegables
        {
            "class": "icon_folder",
            "layer0.tint": "var(dl_text)",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_folder",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": ["hover"]
                }
            ],
            "layer0.tint": "var(dl_text_bright)"
        },
        {
            "class": "icon_folder",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": ["expanded"]
                }
            ],
            "layer0.tint": "var(dl_text_bright)"
        },
        {
            "class": "icon_folder",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": ["selected"]
                }
            ],
            "layer0.tint": "var(dl_accent)"
        },
        {
            "class": "disclosure_button_control",
            "layer0.tint": "var(dl_text)",
            "layer0.opacity": 1.0
        },
        {
            "class": "disclosure_button_control",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": ["hover"]
                }
            ],
            "layer0.tint": "var(dl_text_bright)"
        },
        {
            "class": "disclosure_button_control",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": ["selected"]
                }
            ],
            "layer0.tint": "var(dl_accent)"
        },

        // =========================================================
        // BARRA DE PESTAÑAS (Tabset Control & Borde Inferior Completo)
        // =========================================================
        {
            "class": "tabset_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_tabbar)",
            "layer0.opacity": 1.0,
            // Borde inferior continuo que delimita toda la barra de pestañas
            "layer1.texture": "",
            "layer1.tint": "var(dl_border_cyan)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": [0, 0, 0, 1],
            "content_margin": [0, 0, 0, 0],
            "tab_min_width": 60,
            "tab_height": 36
        },
        // Pestaña Inactiva (Con borde separador lateral y borde inferior cerrado)
        {
            "class": "tab_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_tab_inactive)",
            "layer0.opacity": 1.0,
            "layer1.texture": "",
            "layer1.tint": "var(dl_border_tab)",
            "layer1.opacity": 0.5,
            "layer1.draw_center": false,
            "layer1.inner_margin": [0, 0, 1, 1],
            "content_margin": [16, 8]
        },
        // Pestaña Hover
        {
            "class": "tab_control",
            "attributes": ["hover"],
            "layer0.texture": "",
            "layer0.tint": "var(dl_hover)",
            "layer1.texture": "",
            "layer1.tint": "var(dl_border_tab)",
            "layer1.opacity": 0.8,
            "layer1.draw_center": false,
            "layer1.inner_margin": [0, 0, 1, 1]
        },
        // Pestaña Activa / Seleccionada (Borde superior acento, laterales cian, SIN borde inferior para fundirse con el editor)
        {
            "class": "tab_control",
            "attributes": ["selected"],
            "layer0.texture": "",
            "layer0.tint": "var(dl_tab_active)",
            "layer0.opacity": 1.0,
            // Borde superior cian eléctrico
            "layer1.texture": "",
            "layer1.tint": "var(dl_accent)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": [0, 2, 0, 0],
            // Bordes laterales
            "layer2.texture": "",
            "layer2.tint": "var(dl_border_cyan)",
            "layer2.opacity": 1.0,
            "layer2.draw_center": false,
            "layer2.inner_margin": [1, 0, 1, 0]
        },
        // Etiquetas de Pestañas
        {
            "class": "tab_label",
            "color": "var(dl_text_muted)",
            "font.size": 11
        },
        {
            "class": "tab_label",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": ["hover"]
                }
            ],
            "color": "var(dl_text_bright)"
        },
        {
            "class": "tab_label",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": ["selected"]
                }
            ],
            "color": "var(dl_accent_soft)",
            "font.bold": true
        },
        {
            "class": "tab_label",
            "attributes": ["dirty"],
            "color": "var(dl_orange_soft)"
        },
        {
            "class": "tab_close_button",
            "layer0.tint": "var(dl_text_dim)",
            "layer0.opacity": 0.8
        },
        {
            "class": "tab_close_button",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": ["hover"]
                }
            ],
            "layer0.tint": "var(dl_text_bright)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_close_button",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": ["selected"]
                }
            ],
            "layer0.tint": "var(dl_accent)",
            "layer0.opacity": 1.0
        },

        // =========================================================
        // SEPARADORES DE PANELES (Grid Layout / Splits)
        // =========================================================
        {
            "class": "grid_layout_control",
            "border_size": 1,
            "border_color": "var(dl_border_cyan)"
        },

        // =========================================================
        // PALETA DE COMANDOS Y POPUPS
        // =========================================================
        {
            "class": "overlay_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_panel)",
            "layer0.opacity": 1.0,
            "layer1.texture": "",
            "layer1.tint": "var(dl_border_cyan)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": 1
        },
        {
            "class": "quick_panel",
            "row_padding": [12, 6],
            "layer0.tint": "var(dl_panel)"
        },
        {
            "class": "quick_panel_label",
            "fg": "var(dl_text)",
            "match_fg": "var(dl_accent)",
            "selected_fg": "var(dl_accent)",
            "selected_match_fg": "var(dl_orange_soft)"
        },
        {
            "class": "quick_panel_path_label",
            "fg": "var(dl_text_dim)"
        },
        {
            "class": "mini_quick_panel_row",
            "layer0.tint": [0, 0, 0, 0]
        },
        {
            "class": "mini_quick_panel_row",
            "attributes": ["selected"],
            "layer0.tint": "var(dl_active)"
        },
        {
            "class": "text_line_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_input)",
            "layer0.opacity": 1.0,
            "layer1.texture": "",
            "layer1.tint": "var(dl_border)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": 1
        },

        // =========================================================
        // BARRAS DE DESPLAZAMIENTO (Scrollbars)
        // =========================================================
        {
            "class": "scroll_bar_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_background)",
            "layer0.opacity": 0.0
        },
        {
            "class": "scroll_track_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_sidebar)",
            "layer0.opacity": 0.3
        },
        {
            "class": "puck_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_accent_soft)",
            "layer0.opacity": 0.3
        },
        {
            "class": "puck_control",
            "attributes": ["hover"],
            "layer0.opacity": 0.6
        },
        {
            "class": "puck_control",
            "attributes": ["pressed"],
            "layer0.opacity": 0.9
        },

        // =========================================================
        // BARRA DE ESTADO CON BORDE SUPERIOR
        // =========================================================
        {
            "class": "status_bar",
            "layer0.texture": "",
            "layer0.tint": "var(dl_background)",
            "layer0.opacity": 1.0,
            "layer1.texture": "",
            "layer1.tint": "var(dl_border_cyan)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": [0, 1, 0, 0]
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "status_bar"
                }
            ],
            "color": "var(dl_text)"
        },
        {
            "class": "status_container",
            "content_margin": [12, 4]
        },

        // =========================================================
        // PANELES INFERIORES (Console / Output / Find Panel)
        // =========================================================
        {
            "class": "panel_control",
            "layer0.texture": "",
            "layer0.tint": "var(dl_panel)",
            "layer0.opacity": 1.0,
            "layer1.texture": "",
            "layer1.tint": "var(dl_border_cyan)",
            "layer1.opacity": 1.0,
            "layer1.draw_center": false,
            "layer1.inner_margin": [0, 1, 0, 0]
        }
    ]
}