{
    "extends": "Adaptive.sublime-theme",
    "rules": [
        {
            "class": "sidebar_container",
            "layer0.tint": "#030508",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_tree",
            "row_padding": [12, 6],
            "indent_offset": 12,
            "indent": 14
        },
        {
            "class": "tree_row",
            "layer0.tint": [0, 0, 0, 0],
            "layer0.opacity": 1.0
        },
        {
            "class": "tree_row",
            "attributes": ["hover"],
            "layer0.tint": "#0A1017"
        },
        {
            "class": "tree_row",
            "attributes": ["selected"],
            "layer0.tint": "#0D1B2A"
        },
        {
            "class": "sidebar_heading",
            "color": "#FFFFFF",
            "font.bold": true
        },
        {
            "class": "sidebar_label",
            "color": "#A1A1A1"
        },
        {
            "class": "sidebar_label",
            "parents": [{"class": "tree_row", "attributes": ["hover"]}],
            "color": "#FFFFFF"
        },
        {
            "class": "sidebar_label",
            "parents": [{"class": "tree_row", "attributes": ["selected"]}],
            "color": "#00E8FF"
        },
        {
            "class": "icon_folder",
            "layer0.tint": "#656565"
        },
        {
            "class": "icon_folder",
            "parents": [{"class": "tree_row", "attributes": ["hover"]}],
            "layer0.tint": "#A1A1A1"
        },
        {
            "class": "icon_folder",
            "parents": [{"class": "tree_row", "attributes": ["expanded"]}],
            "layer0.tint": "#00E8FF"
        },
        {
            "class": "icon_folder",
            "parents": [{"class": "tree_row", "attributes": ["selected"]}],
            "layer0.tint": "#00E8FF"
        },
        {
            "class": "disclosure_button_control",
            "layer0.tint": "#656565"
        },
        {
            "class": "disclosure_button_control",
            "parents": [{"class": "tree_row", "attributes": ["hover"]}],
            "layer0.tint": "#A1A1A1"
        },
        {
            "class": "disclosure_button_control",
            "parents": [{"class": "tree_row", "attributes": ["selected"]}],
            "layer0.tint": "#00E8FF"
        },
        {
            "class": "icon_file_type",
            "layer0.opacity": 1.0,
            "layer0.tint": "#A1A1A1"
        },
        {
            "class": "icon_file_type",
            "parents": [{"class": "tree_row", "attributes": ["hover"]}],
            "layer0.tint": "#FFFFFF"
        },
        {
            "class": "icon_file_type",
            "parents": [{"class": "tree_row", "attributes": ["selected"]}],
            "layer0.tint": ""
        },
        {
            "class": "tabset",
            "layer0.tint": "#010305"
        },
        {
            "class": "tab_control",
            "layer0.tint": "#05080C",
            "layer0.opacity": 1.0,
            "content_margin": [16, 8]
        },
        {
            "class": "tab_control",
            "attributes": ["selected"],
            "layer0.tint": "#0A1017"
        },
        {
            "class": "tab_label",
            "color": "#656565"
        },
        {
            "class": "tab_label",
            "parents": [{"class": "tab_control", "attributes": ["selected"]}],
            "color": "#00e1ff"
        },
        {
            "class": "status_bar",
            "layer0.tint": "#010305"
        },
        {
            "class": "label_control",
            "parents": [{"class": "status_bar"}],
            "color": "#A1A1A1"
        },
        {
            "class": "overlay_control",
            "layer0.tint": "#05080C"
        },
        {
            "class": "text_line_control",
            "layer0.tint": "#080D14"
        }
    ]
}