{
    "extends": "Default Dark.sublime-theme",
    "variables": {
        "bg": "#04080C",
        "bg-alt": "#080D13",
        "bg-alt2": "#060A0F",
        "bg-input": "#060B10",
        "fg": "#FFFFFF",
        "fg-muted": "#c8f9ff",
        "fg-dim": "#656565",
        "border": "#0099DD30",
        "line-highlight": "#0D151E",
        "selection": "#0f253a",
        "cyan": "#00FFCC",
        "cyan-soft": "#8AFDFF",
        "orange": "#FF6D00",
        "orange-soft": "#FF9100",
        "pink": "#FF2A5F"
    },
    "rules": [
        {
            "class": "title_bar",
            "style": "dark",
            "bg": "var(bg)",
            "fg": "var(fg)"
        },
        {
            "class": "sidebar_container",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_tree",
            "row_padding": [
                14,
                4
            ],
            "indent_offset": 12,
            "indent": 14
        },
        {
            "class": "sidebar_heading",
            "color": "var(fg)",
            "font.bold": true
        },
        {
            "class": "sidebar_label",
            "color": "var(fg-muted)"
        },
        {
            "class": "tree_row",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tree_row",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(selection)",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_label",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "color": "var(fg)"
        },
        {
            "class": "sidebar_label",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "color": "var(cyan)",
            "font.bold": true
        },
        {
            "class": "tabset_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0,
            "tab_height": 34
        },
        {
            "class": "tab_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0,
            "content_margin": [
                14,
                4
            ]
        },
        {
            "class": "tab_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_control",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_label",
            "color": "var(fg)"
        },
        {
            "class": "tab_label",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "color": "var(cyan-soft)"
        },
        {
            "class": "tab_label",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "color": "var(cyan)",
            "font.bold": true
        },
        {
            "class": "tab_label",
            "attributes": [
                "dirty"
            ],
            "color": "var(orange-soft)"
        },
        {
            "class": "tab_close_button",
            "layer0.tint": "var(fg-dim)",
            "layer0.opacity": 0.7
        },
        {
            "class": "tab_close_button",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "layer0.tint": "var(fg)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_close_button",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "layer0.tint": "var(cyan)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_close_button",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(pink)",
            "layer0.opacity": 1.0
        },
        {
            "class": "scroll_bar_control",
            "layer0.tint": "var(bg)",
            "layer0.opacity": 1.0
        },
        {
            "class": "scroll_track_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 0.5
        },
        {
            "class": "puck_control",
            "layer0.tint": "var(cyan)",
            "layer0.opacity": 0.35
        },
        {
            "class": "puck_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(cyan)",
            "layer0.opacity": 0.75
        },
        {
            "class": "puck_control",
            "attributes": [
                "pressed"
            ],
            "layer0.tint": "var(cyan)",
            "layer0.opacity": 1.0
        },
        {
            "class": "status_bar",
            "layer0.tint": "var(bg)",
            "layer0.opacity": 1.0
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "status_bar"
                }
            ],
            "color": "var(fg-muted)"
        },
        {
            "class": "panel_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0
        },
        {
            "class": "text_line_control",
            "layer0.tint": "var(bg-input)",
            "layer0.opacity": 1.0
        },
        {
            "class": "button_control",
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "button_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(selection)",
            "layer0.opacity": 1.0
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "button_control"
                }
            ],
            "color": "var(fg)",
            "font.bold": true
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "button_control",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "color": "var(cyan)"
        },
        {
            "class": "icon_button_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 0.8
        },
        {
            "class": "icon_button_control",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(selection)",
            "layer0.opacity": 1.0
        },
        {
            "class": "overlay_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "popup_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        }
    ]
}