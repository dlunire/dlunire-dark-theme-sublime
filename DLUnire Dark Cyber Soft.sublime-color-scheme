{
    "name": "DLUnire Dark Cyber Soft",
    "author": "dlunire",
    "variables": {
        "bg": "#04080C",
        "bg-alt": "#080D13",
        "bg-alt2": "#060A0F",
        "bg-input": "#060B10",
        "fg": "#FFFFFF",
        "fg-muted": "#c8f9ff",
        "fg-dim": "#656565",
        "border": "#0099DD20",
        "line-highlight": "#0D151E",
        "selection": "#0091ff33",
        "list-selection": "#0D1B2A",
        "cyan": "#00E8FF",
        "cyan-neon": "#00FFCC",
        "cyan-soft": "#8afdff",
        "cyan-strong": "#00D0FF",
        "green-neon": "#00FFAA",
        "orange": "#FF6D00",
        "orange-soft": "#FF9100",
        "amber": "#FFD580",
        "purple-soft": "#B983FF",
        "enum-cyan": "#33EEFF",
        "operators-slate": "#5C7A88",
        "yellow": "#FFC600",
        "peach": "#FAA859",
        "purple": "#A0A0FF",
        "pink": "#F50057",
        "red-neon": "#FF2A5F",
        "teal": "#1DE9B6",
        "string-cyber": "#ffffffc0"
    },
    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "var(cyan)",
        "block_caret": "var(cyan)",
        "line_highlight": "var(line-highlight)",
        "selection": "var(selection)",
        "selection_foreground": "var(fg)",
        "selection_border": "var(border)",
        "inactive_selection": "var(bg-alt)",
        "gutter": "var(bg)",
        "gutter_foreground": "var(operators-slate)",
        "guide": "var(border)",
        "active_guide": "var(cyan)",
        "stack_guide": "var(border)",
        "highlight": "var(cyan)",
        "find_highlight": "var(yellow)",
        "find_highlight_foreground": "var(bg)",
        "brackets_options": "underline",
        "brackets_foreground": "var(cyan)",
        "bracket_contents_options": "underline",
        "bracket_contents_foreground": "var(cyan-soft)",
        "tags_options": "stippled_underline",
        "shadow": "#00000055",
        "misspelling": "var(red-neon)",
        "minimap_overlay": "#00E8FF1A",
        "minimap_border": "#00E8FF4D"
    },
    "rules": [
        {
            "name": "Comments",
            "scope": "comment, comment.block, comment.line, comment.block.documentation",
            "foreground": "var(fg-dim)",
            "font_style": "normal"
        },
        {
            "name": "Keywords",
            "scope": "keyword, keyword.control, keyword.operator.word, storage.modifier, storage.type, storage",
            "foreground": "var(orange)"
        },
        {
            "name": "Primitive types",
            "scope": "support.type, support.type.primitive, keyword.type, storage.type.primitive",
            "foreground": "var(teal)"
        },
        {
            "name": "Strings",
            "scope": "string, string.quoted, string.template, string.regexp",
            "foreground": "var(string-cyber)"
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "foreground": "var(peach)"
        },
        {
            "name": "Constants",
            "scope": "constant, constant.language, constant.character.escape",
            "foreground": "var(purple)"
        },
        {
            "name": "Variables",
            "scope": "variable, variable.parameter, variable.other, variable.language, variable.object",
            "foreground": "var(cyan)"
        },
        {
            "name": "Properties",
            "scope": "variable.other.property, support.type.property-name, meta.property-name, entity.name.variable",
            "foreground": "var(orange-soft)"
        },
        {
            "name": "Functions",
            "scope": "entity.name.function, support.function, meta.function-call, variable.function, entity.name.method",
            "foreground": "var(cyan-soft)"
        },
        {
            "name": "Inherited Classes",
            "scope": "entity.other.inherited-class, meta.other.inherited-class",
            "foreground": "var(cyan-strong)"
        },
        {
            "name": "Classes",
            "scope": "entity.name.type.class, entity.name.class, support.class, entity.name.trait",
            "foreground": "var(green-neon)"
        },
        {
            "name": "Interfaces",
            "scope": "entity.name.interface, support.interface",
            "foreground": "var(purple-soft)"
        },
        {
            "name": "Structs",
            "scope": "entity.name.struct, support.struct",
            "foreground": "var(amber)"
        },
        {
            "name": "Enums",
            "scope": "entity.name.enum, support.enum, constant.other.enum",
            "foreground": "var(enum-cyan)"
        },
        {
            "name": "Attributes / Decorators",
            "scope": "entity.other.attribute-name, meta.annotation, storage.type.annotation",
            "foreground": "var(pink)"
        },
        {
            "name": "HTML/XML Tags",
            "scope": "entity.name.tag",
            "foreground": "var(teal)"
        },
        {
            "name": "HTML/XML Attributes",
            "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
            "foreground": "var(pink)"
        },
        {
            "name": "Operators & Punctuation",
            "scope": "keyword.operator, punctuation.separator, punctuation.terminator, punctuation.accessor",
            "foreground": "var(operators-slate)"
        },
        {
            "name": "Markdown Headings",
            "scope": "markup.heading, markup.heading.markdown",
            "foreground": "var(cyan-strong)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
            "foreground": "var(yellow)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "foreground": "var(cyan)",
            "font_style": "italic"
        },
        {
            "name": "Markdown Links",
            "scope": "markup.underline.link, string.other.link",
            "foreground": "var(cyan-strong)",
            "font_style": "underline"
        },
        {
            "name": "Markdown Lists",
            "scope": "markup.list",
            "foreground": "var(orange)"
        },
        {
            "name": "Markdown Quotes",
            "scope": "markup.quote",
            "foreground": "var(fg-dim)"
        },
        {
            "name": "Invalid",
            "scope": "invalid, invalid.illegal",
            "foreground": "var(red-neon)",
            "font_style": "underline"
        }
    ]
}
