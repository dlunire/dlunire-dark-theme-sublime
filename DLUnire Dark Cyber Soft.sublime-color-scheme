{
    "name": "DLUnire Dark Cyber Soft",
    "author": "dlunire",
    "variables": {
        "bg": "#04080C",
        "bg-alt": "#080D13",
        "bg-alt2": "#060A0F",
        "bg-input": "#0B121B",
        "fg": "#FFFFFF",
        "fg-muted": "#c8f9ff",
        "fg-dim": "#656565",
        "border": "#0099DD2D",
        "guide-color": "#00b3ff",
        "active-guide": "#00bbff40",
        "line-highlight": "#0D151E",
        "selection": "#0091ff33",
        "selection-border": "#00E8FF",
        "inactive-selection": "#0D151E",
        "cyan": "#00E8FF",
        "cyan-param": "#70F3FF",
        "cyan-soft": "#8AFDFF",
        "cyan-strong": "#00D0FF",
        "cyan-inherited": "#00F5FF",
        "orange": "#FF6D00",
        "orange-soft": "#FF9100",
        "yellow": "#FFC600",
        "peach": "#FAA859",
        "purple": "#A0A0FF",
        "interface-color": "#B983FF",
        "struct-color": "#FFD580",
        "enum-color": "#33EEFF",
        "namespace-color": "#00E5D8",
        "operator-color": "#5C7A88",
        "pink": "#F50057",
        "red": "#FF2A5F",
        "teal": "#1DE9B6",
        "green": "#00FF00",
        "mint": "#00FFAA",
        "vcs-added": "#00FFAA",
        "vcs-modified": "#FFFFFF",
        "vcs-deleted": "#FF2A5F",
        "vcs-untracked": "#00E8FF",
        "minimap-shadow": "#0080d420"
    },
    "globals": {
        "background": "var(bg)",
        "foreground": "var(fg)",
        "caret": "var(cyan)",
        "block_caret": "var(cyan)",
        "line_highlight": "var(line-highlight)",
        "selection": "var(selection)",
        "selection_foreground": "var(fg)",
        "selection_border": "var(selection-border)",
        "inactive_selection": "var(inactive-selection)",
        "gutter": "var(bg)",
        "gutter_foreground": "var(fg-muted)",
        "guide": "var(guide-color)",
        "active_guide": "var(active-guide)",
        "find_highlight": "var(yellow)",
        "find_highlight_foreground": "var(bg)",
        "brackets_options": "underline",
        "brackets_foreground": "var(cyan)",
        "bracket_contents_options": "underline",
        "bracket_contents_foreground": "var(cyan-soft)",
        "tags_options": "stippled_underline",
        "shadow": "#0080d420",
        "misspelling": "var(red)",
        "vcs_added": "var(vcs-added)",
        "vcs_modified": "var(vcs-modified)",
        "vcs_deleted": "var(vcs-deleted)",
        "vcs_untracked": "var(vcs-untracked)"
    },
    "rules": [
        {
            "name": "Comments",
            "scope": "comment, comment.block, comment.line, comment.block.documentation",
            "foreground": "var(fg-dim)",
            "font_style": "normal"
        },
        {
            "name": "Keywords",
            "scope": "keyword, keyword.control, keyword.operator.word, storage.modifier, storage.type, storage",
            "foreground": "var(orange)"
        },
        {
            "name": "Primitive types",
            "scope": "support.type, support.type.primitive, keyword.type, storage.type.primitive, entity.name.type.primitive",
            "foreground": "var(teal)"
        },
        {
            "name": "Strings",
            "scope": "string, string.quoted, string.template, string.regexp",
            "foreground": "var(fg)"
        },
        {
            "name": "Properties & JSON Keys",
            "scope": "meta.mapping.key.json string.quoted.double.json, meta.mapping.key string, meta.mapping.key, variable.other.property, variable.other.member, support.type.property-name, meta.property-name, entity.name.tag.json, entity.name.tag.yaml, entity.name.variable.property",
            "foreground": "var(orange-soft)"
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "foreground": "var(peach)"
        },
        {
            "name": "Constants",
            "scope": "constant, constant.language, constant.character.escape, constant.other",
            "foreground": "var(purple)"
        },
        {
            "name": "Variables",
            "scope": "variable, variable.other, variable.language, variable.object",
            "foreground": "var(cyan)"
        },
        {
            "name": "Parameters",
            "scope": "variable.parameter",
            "foreground": "var(cyan-param)"
        },
        {
            "name": "Functions",
            "scope": "entity.name.function, support.function, meta.function-call, variable.function, entity.name.method",
            "foreground": "var(cyan-soft)"
        },
        {
            "name": "Inherited Classes",
            "scope": "entity.other.inherited-class, entity.other.inherited-class.php, meta.other.inherited-class",
            "foreground": "var(cyan-inherited)"
        },
        {
            "name": "Classes & Traits",
            "scope": "entity.name.type.class, entity.name.class, support.class, support.type.class, entity.name.trait",
            "foreground": "var(green)"
        },
        {
            "name": "Interfaces",
            "scope": "entity.name.interface, entity.name.type.interface, support.type.interface, support.interface",
            "foreground": "var(interface-color)"
        },
        {
            "name": "Structs",
            "scope": "entity.name.struct, entity.name.type.struct, support.type.struct",
            "foreground": "var(struct-color)"
        },
        {
            "name": "Enums",
            "scope": "entity.name.enum, entity.name.type.enum, support.type.enum",
            "foreground": "var(enum-color)"
        },
        {
            "name": "Namespaces",
            "scope": "entity.name.namespace, entity.name.type.namespace, support.type.namespace",
            "foreground": "var(namespace-color)"
        },
        {
            "name": "Attributes / Decorators",
            "scope": "entity.other.attribute-name, meta.annotation, storage.type.annotation",
            "foreground": "var(pink)"
        },
        {
            "name": "HTML/XML Tags",
            "scope": "entity.name.tag",
            "foreground": "var(teal)"
        },
        {
            "name": "HTML/XML Attributes",
            "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
            "foreground": "var(pink)"
        },
        {
            "name": "Operators & Punctuation",
            "scope": "keyword.operator, storage.type.function.arrow",
            "foreground": "var(operator-color)"
        },
        {
            "name": "Markdown Headings",
            "scope": "markup.heading, markup.heading.markdown",
            "foreground": "var(cyan-strong)"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
            "foreground": "var(yellow)",
            "font_style": "bold"
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "foreground": "var(cyan)",
            "font_style": "italic"
        },
        {
            "name": "Markdown Links",
            "scope": "markup.underline.link, string.other.link",
            "foreground": "var(cyan-strong)",
            "font_style": "underline"
        },
        {
            "name": "Markdown Lists",
            "scope": "markup.list",
            "foreground": "var(orange)"
        },
        {
            "name": "Markdown Quotes",
            "scope": "markup.quote",
            "foreground": "var(fg-dim)"
        },
        {
            "name": "Invalid",
            "scope": "invalid, invalid.illegal",
            "foreground": "var(red)",
            "font_style": "underline"
        },
        {
            "name": "Diff Inserted",
            "scope": "markup.inserted",
            "foreground": "var(vcs-added)"
        },
        {
            "name": "Diff Changed",
            "scope": "markup.changed",
            "foreground": "var(cyan)"
        },
        {
            "name": "Diff Deleted",
            "scope": "markup.deleted",
            "foreground": "var(vcs-deleted)"
        }
    ]
}