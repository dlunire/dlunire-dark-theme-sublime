{
    "extends": "Default Dark.sublime-theme",
    "variables": {
        "bg": "#07090b",
        "bg-alt": "#0a0d10",
        "bg-alt2": "#070a0d",
        "bg-input": "#0c1015",
        "fg": "#FFFFFF",
        "fg-muted": "#c8f9ff",
        "fg-dim": "#808080",
        "border": "#00A6FF",
        "border_subtle": "#00A6FF",
        "line-highlight": "#0f1418",
        "selection": "#0f2030",
        "cyan": "#00b3ff",
        "cyan-soft": "#A0E5FF",
        "scrollbar_puck": "#00A6FF",
        "orange": "#FF6D00",
        "orange-soft": "#FF9100",
        "pink": "#F50057",
        "minimap_color": "#0080d420",
        "icon_color": "#00f0ffd0",
        "button_color": "#0080d4",
        "button": "#002030",
        "button_hover": "#003040",
        "button_active": "#002030"
    },
    "rules": [
        {
            "class": "title_bar",
            "style": "dark",
            "bg": "var(bg)",
            "fg": "var(fg)"
        },
        {
            "class": "sidebar_container",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0,
            "content_margin": 0
        },
        {
            "class": "sidebar_tree",
            "row_padding": [
                14,
                4
            ],
            "indent_offset": 12,
            "indent": 15
        },
        {
            "class": "sidebar_heading",
            "color": "var(cyan)",
            "font.bold": true
        },
        {
            "class": "sidebar_label",
            "color": "var(fg-muted)"
        },
        {
            "class": "tree_row",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tree_row",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(selection)",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_label",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "color": "var(fg)"
        },
        {
            "class": "sidebar_label",
            "parents": [
                {
                    "class": "tree_row",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "color": "var(cyan)",
            "font.bold": true
        },
        {
            "class": "disclosure_button_control",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_folder",
            "layer0.tint": "var(icon_color)",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_folder_dup",
            "layer0.tint": "var(icon_color)",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_file_type",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_button_control",
            "layer0.tint": "var(button_color)",
            "layer0.opacity": 1.0
        },
        {
            "class": "grid_layout_control",
            "border_size": 1,
            "border_color": "var(border)"
        },
        {
            "class": "grid_layout_control",
            "parents": [
                {
                    "class": "edit_window"
                }
            ],
            "border_size": 1,
            "border_color": "var(border)"
        },
        {
            "class": "grid_layout_control",
            "parents": [
                {
                    "class": "edit_window",
                    "attributes": [
                        "file_dark"
                    ]
                }
            ],
            "border_size": 1,
            "border_color": "var(border)"
        },
        {
            "class": "grid_layout_control",
            "parents": [
                {
                    "class": "edit_window",
                    "attributes": [
                        "file_medium_dark"
                    ]
                }
            ],
            "border_size": 1,
            "border_color": "var(border)"
        },
        {
            "class": "grid_layout_control",
            "parents": [
                {
                    "class": "edit_window",
                    "attributes": [
                        "file_light"
                    ]
                }
            ],
            "border_size": 1,
            "border_color": "var(border)"
        },
        {
            "class": "tabset_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0,
            "tab_height": 34
        },
        {
            "class": "tab_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0,
            "layer2.texture": "Theme - Default/common/tab_square_highlight.png",
            "layer2.inner_margin": [
                0,
                2,
                0,
                0
            ],
            "layer2.tint": "var(cyan)",
            "layer2.opacity": 0.0,
            "content_margin": [
                14,
                4
            ]
        },
        {
            "class": "tab_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0,
            "layer2.opacity": 0.0
        },
        {
            "class": "tab_control",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0,
            "layer2.opacity": 1.0
        },
        {
            "class": "tab_label",
            "color": "#ffffff",
            "opacity": 1.0
        },
        {
            "class": "tab_label",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "color": "var(cyan-soft)"
        },
        {
            "class": "tab_label",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "color": "var(cyan)",
            "font.bold": true
        },
        {
            "class": "tab_label",
            "attributes": [
                "dirty"
            ],
            "color": "var(orange-soft)"
        },
        {
            "class": "tab_close_button",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_close_button",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_close_button",
            "parents": [
                {
                    "class": "tab_control",
                    "attributes": [
                        "selected"
                    ]
                }
            ],
            "layer0.tint": "var(cyan)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_close_button",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(pink)",
            "layer0.opacity": 1.0
        },
        {
            "class": "scroll_bar_control",
            "layer0.tint": "var(bg)",
            "layer0.opacity": 1.0
        },
        {
            "class": "scroll_track_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 0.5
        },
        {
            "class": "puck_control",
            "layer0.tint": "var(scrollbar_puck)",
            "layer0.opacity": 0.5
        },
        {
            "class": "puck_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(scrollbar_puck)",
            "layer0.opacity": 0.85
        },
        {
            "class": "puck_control",
            "attributes": [
                "pressed"
            ],
            "layer0.tint": "var(scrollbar_puck)",
            "layer0.opacity": 1.0
        },
        {
            "class": "status_bar",
            "layer0.tint": "#001020",
            "layer0.opacity": 1.0,
            "content_margin": [
                8,
                1,
                8,
                0
            ]
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "status_bar"
                }
            ],
            "color": "var(fg-muted)"
        },
        {
            "class": "vcs_branch_icon",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "panel_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0,
            "content_margin": [
                2,
                4,
                2,
                2
            ]
        },
        {
            "class": "text_line_control",
            "layer0.tint": "var(bg-input)",
            "layer0.opacity": 1.0
        },
        {
            "class": "button_control",
            "layer0.tint": "var(button)",
            "layer0.opacity": 1.0
        },
        {
            "class": "button_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(button_hover)",
            "color": "white",
            "layer0.opacity": 1.0
        },
        {
            "class": "button_control",
            "attributes": [
                "pressed"
            ],
            "layer0.tint": "var(button_active)",
            "layer0.opacity": 1.0
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "button_control"
                }
            ],
            "color": "var(fg)",
            "font.bold": true
        },
        {
            "class": "label_control",
            "parents": [
                {
                    "class": "button_control",
                    "attributes": [
                        "hover"
                    ]
                }
            ],
            "color": "white"
        },
        {
            "class": "icon_button_control",
            "layer0.tint": "var(button)",
            "layer0.opacity": 0.0
        },
        {
            "class": "icon_button_control",
            "attributes": [
                "hover"
            ],
            "layer0.tint": "var(button_hover)",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_button_control",
            "attributes": [
                "selected"
            ],
            "layer0.tint": "var(button_active)",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_regex",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_case_match",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_whole_word",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_wrap",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_in_selection",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_highlight",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_preserve_case",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_context",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_use_buffer",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "icon_use_gitignore",
            "layer0.tint": "#FFFFFF",
            "layer0.opacity": 1.0
        },
        {
            "class": "overlay_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "popup_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "minimap_control",
            "viewport_color": "var(minimap_color)"
        }
    ]
}