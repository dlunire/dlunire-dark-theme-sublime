{
    "extends": "Default Dark.sublime-theme",
    "variables": {
        "bg": "#010305",
        "bg-alt": "#05080C",
        "bg-alt2": "#030508",
        "fg": "#FFFFFF",
        "fg-muted": "#A1A1A1",
        "fg-dim": "#656565",
        "border": "#2A3846",
        "line-highlight": "#0A1017",
        "selection": "#10324C",
        "cyan": "#00E8FF",
        "cyan-soft": "#A0E5FF",
        "orange": "#FF6D00",
        "orange-soft": "#FF9100",
        "pink": "#F50057"
    },
    "rules": [
        {
            "class": "sidebar_container",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_tree",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "sidebar_heading",
            "color": "var(fg)",
            "font.bold": true
        },
        {
            "class": "sidebar_label",
            "color": "var(fg-muted)"
        },
        {
            "class": "sidebar_label",
            "parents": [{"class": "tree_row", "attributes": ["selected"]}],
            "color": "var(cyan)"
        },
        {
            "class": "tree_row",
            "attributes": ["hover"],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tree_row",
            "attributes": ["selected"],
            "layer0.tint": "var(selection)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tabset_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_control",
            "attributes": ["selected"],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 1.0
        },
        {
            "class": "tab_control",
            "attributes": ["hover", "!selected"],
            "layer0.tint": "var(line-highlight)",
            "layer0.opacity": 0.6
        },
        {
            "class": "tab_label",
            "color": "var(fg-dim)"
        },
        {
            "class": "tab_label",
            "parents": [{"class": "tab_control", "attributes": ["selected"]}],
            "color": "var(cyan)"
        },
        {
            "class": "tab_label",
            "attributes": ["dirty"],
            "color": "var(orange-soft)"
        },
        {
            "class": "status_bar",
            "layer0.tint": "var(bg)",
            "layer0.opacity": 1.0
        },
        {
            "class": "label_control",
            "parents": [{"class": "status_container"}],
            "color": "var(fg-muted)"
        },
        {
            "class": "scroll_bar_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 0.6
        },
        {
            "class": "scroll_track_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 0.3
        },
        {
            "class": "puck_control",
            "layer0.tint": "var(cyan-soft)",
            "layer0.opacity": 0.4
        },
        {
            "class": "overlay_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "quick_panel_label",
            "fg": "var(fg)",
            "match_fg": "var(cyan)",
            "selected_fg": "var(cyan)",
            "selected_match_fg": "var(orange-soft)",
            "bg": "var(bg-alt2)"
        },
        {
            "class": "quick_panel_path_label",
            "fg": "var(fg-dim)"
        },
        {
            "class": "popup_control",
            "layer0.tint": "var(bg-alt2)",
            "layer0.opacity": 1.0
        },
        {
            "class": "title_bar",
            "style": "dark"
        },
        {
            "class": "title_bar",
            "platforms": ["osx"],
            "fg": "var(fg)",
            "bg": "var(bg)"
        },
        {
            "class": "button_control",
            "layer0.tint": "var(bg-alt)",
            "layer0.opacity": 1.0
        },
        {
            "class": "label_control",
            "parents": [{"class": "button_control"}],
            "color": "var(fg)"
        },
        {
            "class": "text_line_control",
            "color_scheme_tint": "var(bg-alt2)"
        }
    ]
}