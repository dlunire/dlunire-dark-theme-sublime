{
    "name": "DLUnire Dark",
    "globals": {
        "background": "#010305",
        "foreground": "#FFFFFF",
        "caret": "#00E8FF",
        "line_highlight": "#0A1017",
        "selection": "#10324C",
        "gutter": "#010305",
        "gutter_foreground": "#2A3846",
        "misspelling": "#F50057",
        // Configuración del Minimapa
        "minimap_overlay": "#00E8FF1A",
        "minimap_border": "#00E8FF4D"
    },
    "rules": [
        {
            "name": "Comments",
            "scope": "comment, comment.block, comment.line, comment.block.documentation",
            "foreground": "#656565"
        },
        {
            "name": "Keywords",
            "scope": "keyword, keyword.control, keyword.operator.word, storage.modifier, storage.type, storage",
            "foreground": "#FF6D00"
        },
        {
            "name": "Primitive types",
            "scope": "support.type, support.type.primitive, keyword.type, storage.type.primitive",
            "foreground": "#FFC600"
        },
        {
            "name": "Strings",
            "scope": "string, string.quoted, string.template, string.regexp",
            "foreground": "#FFFFFF"
        },
        {
            "name": "Numbers",
            "scope": "constant.numeric",
            "foreground": "#FAA859"
        },
        {
            "name": "Constants",
            "scope": "constant, constant.language, constant.character.escape",
            "foreground": "#A0A0FF"
        },
        {
            "name": "Variables",
            "scope": "variable, variable.parameter, variable.other, variable.language, variable.object",
            "foreground": "#00E8FF"
        },
        {
            "name": "Properties",
            "scope": "variable.other.property, support.type.property-name, meta.property-name, entity.name.variable",
            "foreground": "#FF9100"
        },
        {
            "name": "Functions",
            "scope": "entity.name.function, support.function, meta.function-call, variable.function, entity.name.method",
            "foreground": "#A0E5FF"
        },
        {
            "name": "Classes",
            "scope": "entity.name.type, entity.name.class, entity.name.namespace, support.class, support.type.class, entity.name.struct, entity.name.interface, entity.name.enum, entity.name.trait",
            "foreground": "#00FF00"
        },
        {
            "name": "Attributes / Decorators",
            "scope": "entity.other.attribute-name, meta.annotation, storage.type.annotation",
            "foreground": "#F50057"
        },
        {
            "name": "HTML/XML Tags",
            "scope": "entity.name.tag",
            "foreground": "#1DE9B6"
        },
        {
            "name": "HTML/XML Attributes",
            "scope": "entity.other.attribute-name.html, entity.other.attribute-name.xml",
            "foreground": "#F50057"
        },
        {
            "name": "Markdown Headings",
            "scope": "markup.heading, markup.heading.markdown",
            "foreground": "#00D0FF"
        },
        {
            "name": "Markdown Bold",
            "scope": "markup.bold",
            "foreground": "#FFC600",
            "font_style": "bold"
        },
        {
            "name": "Markdown Italic",
            "scope": "markup.italic",
            "foreground": "#00E8FF",
            "font_style": "italic"
        },
        {
            "name": "Markdown Links",
            "scope": "markup.underline.link, string.other.link",
            "foreground": "#00D0FF",
            "font_style": "underline"
        },
        {
            "name": "Markdown Lists",
            "scope": "markup.list",
            "foreground": "#FF6D00"
        },
        {
            "name": "Markdown Quotes",
            "scope": "markup.quote",
            "foreground": "#656565"
        },
        {
            "name": "Invalid",
            "scope": "invalid, invalid.illegal",
            "foreground": "#FFFFFF"
        }
    ]
}